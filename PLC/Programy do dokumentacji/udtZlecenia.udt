TYPE "udtZlecenia"
VERSION : 0.1
   STRUCT
      Zlecenie : Struct
         ID : Int;   // Numer zlecenia
         Model : Int;   // Rodzaj modelu 2-8
         PartNo : Int;   // Nr sztuki
         "Time" : Struct   // Czasy na stanowiskach
            Stanowisko1 : Struct
               StartTime {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;   // Czas rozpoczecia
               EndTime {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;   // Czas zakonczenia
               TargetTime : Int;   // Zakladany czas
               ActualTime : Int;
               Abort : Bool;   // Czy anulowano produkcje na tym stanowisku
            END_STRUCT;
            Stanowisko2 : Struct
               StartTime {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;   // Czas rozpoczecia
               EndTime {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;   // Czas zakonczenia
               TargetTime : Int;   // Zakladany czas
               ActualTime : Int;
               Abort : Bool;   // Czy anulowano produkcje na tym stanowisku
            END_STRUCT;
            Stanowisko3 : Struct
               StartTime {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;   // Czas rozpoczecia
               EndTime {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;   // Czas zakonczenia
               TargetTime : Int;   // Zakladany czas
               ActualTime : Int;
               Abort : Bool;   // Czy anulowano produkcje na tym stanowisku
            END_STRUCT;
            StanowiskoQC : Struct
               StartTime {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;   // Czas rozpoczecia
               EndTime {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;   // Czas zakonczenia
               TargetTime : Int;   // Zakladany czas
               ActualTime : Int;
               Abort : Bool;   // Czy anulowano produkcje na tym stanowisku
            END_STRUCT;
         END_STRUCT;
         Alarm : Struct
            Stanowisko1 : Struct
               MissingPart : Bool;
               DamagedPart : Bool;
               PalletFault : Bool;
               WrongInstruction : Bool;
               SensorFault : Bool;
               Other : Bool;
            END_STRUCT;
            Stanowisko2 : Struct
               MissingPart : Bool;
               DamagedPart : Bool;
               PalletFault : Bool;
               WrongInstruction : Bool;
               SensorFault : Bool;
               Other : Bool;
            END_STRUCT;
            Stanowisko3 : Struct
               MissingPart : Bool;
               DamagedPart : Bool;
               PalletFault : Bool;
               WrongInstruction : Bool;
               SensorFault : Bool;
               Other : Bool;
            END_STRUCT;
            StanowieskoQC : Struct
               Camera : Bool;
               NOK : Bool;
               PalletFault : Bool;
               RFID : Bool;
               SensorFault : Bool;
               Other : Bool;
            END_STRUCT;
         END_STRUCT;
         ReturnQC : Bool;   // True - poprawny wyrób, False zły wyrób
         Priority : Int;   // 0 - Najniższy, 5 - Najwyższy
         Status : Array[0..3] of Bool;   // Status czy skonczono na danym stanowisku
         NOK : Struct
            NoBrick : Bool;
            WrongColour : Bool;
            Offset : Bool;
            Damage : Bool;
            WrongNumber : Bool;
            Other : Bool;
         END_STRUCT;
      END_STRUCT;
   END_STRUCT;

END_TYPE


@page "/magazyn"
@inject AuthService Auth
@inject InventoryService Inv
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>Magazyn komponentów — Linia Montażowa</PageTitle>

@if (!Auth.IsLoggedIn) { return; }


<!-- NAGŁÓWEK -->
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
    <div>
        <MudText Typo="Typo.h4" Style="font-weight:800;color:var(--text);">Magazyn komponentów</MudText>
        <MudText Typo="Typo.body2" Style="color:var(--text-muted);">
            Elementy LEGO · @_mainItems.Count pozycji w magazynie głównym
        </MudText>
        @if (_mainItems.Any(i => i.Dostepny < 0))
        {
            <MudText Typo="Typo.body2" Style="color:var(--danger);font-weight:700;margin-top:4px;">
                ⚠ Zadłużenie magazynu: @_mainItems.Count(i => i.Dostepny < 0) pozycji poniżej zera
                (zlecenia zatwierdzone mimo braków)
            </MudText>
        }
    </div>
    <MudButton Variant="Variant.Outlined" Color="Color.Error"
               StartIcon="@Icons.Material.Filled.RestartAlt"
               OnClick="PotwierdzenieReset">
        Resetuj do stanu bazowego
    </MudButton>
</div>

<!-- ZAKŁADKI -->
<MudTabs Elevation="2" Rounded="true" Class="mb-4" PanelClass="pa-4">

    <!-- MAGAZYN GŁÓWNY -->
    <MudTabPanel Text="Magazyn główny (MAIN)">
        <MudTable Items="_mainItems" Dense="true" Hover="true" Striped="true"
                  Filter="FilterItem" @ref="_tableMain">
            <ToolBarContent>
                <MudTextField @bind-Value="_searchText" Placeholder="Szukaj..."
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium" Class="mt-0" Immediate="true" />
                <MudSpacer />
                <MudText Typo="Typo.caption" Style="color:var(--text-muted);">
                    Niski stan: @_mainItems.Count(i => i.NiskiStan) pozycji
                </MudText>
            </ToolBarContent>
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<InventoryItem,object>(i=>i.Wymiary)">Wymiary</MudTableSortLabel></MudTh>
                <MudTh>Typ</MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<InventoryItem,object>(i=>i.Kolor)">Kolor</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<InventoryItem,object>(i=>i.StanBiezacy)">Stan</MudTableSortLabel></MudTh>
                <MudTh>Na pojemnik</MudTh>
                <MudTh>Zarezerwowane</MudTh>
                <MudTh>Dostępne</MudTh>
                <MudTh>Stan wizualny</MudTh>
                <MudTh>Korekta</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudText Style="font-weight:600;font-family:monospace;">@context.Wymiary</MudText>
                </MudTd>
                <MudTd><MudText Typo="Typo.caption">@context.TypWysokosci</MudText></MudTd>
                <MudTd>
                    <div style="display:flex;align-items:center;gap:8px;">
                        <div style=@($"width:14px;height:14px;border-radius:3px;background:{LegoColor(context.Kolor)};border:1px solid rgba(0,0,0,0.2);flex-shrink:0;")></div>
                        @context.Kolor
                    </div>
                </MudTd>
                <MudTd>
                    <MudText Style=@($"font-weight:800;color:{(context.NiskiStan ? "#EF4444" : "var(--text)")}")>
                        @context.StanBiezacy
                    </MudText>
                </MudTd>
                <MudTd>
                    <MudText Typo="Typo.body2" Style="color:var(--text-muted);">
                        @(context.PojemnoscPojemnika > 0 ? context.PojemnoscPojemnika.ToString() : "—")
                    </MudText>
                </MudTd>
                <MudTd>
                    @if (context.IloscZarezerwowana > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                 Style="height:20px;">@context.IloscZarezerwowana</MudChip>
                    }
                    else { <span style="color:var(--text-muted);">—</span> }
                </MudTd>
                <MudTd>
                    <MudText Style=@($"font-weight:800;color:{StanColor(context.ProcentDostepny)}")>
                        @context.Dostepny
                    </MudText>
                </MudTd>
                <MudTd>
                    <MudProgressLinear Value="@context.ProcentPelny"
                                       Color="@StanMudColor(context.ProcentPelny)"
                                       Style="min-width:80px;background:var(--track);" Rounded="true" Size="Size.Small" />
                </MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Tune"
                               OnClick="@(() => OpenKorekta(context))">
                        Uzupełnij
                    </MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Style="padding:20px;color:var(--text-muted);">Brak komponentów w magazynie.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudTabPanel>

    <!-- HISTORIA TRANSAKCJI -->
    <MudTabPanel Text="Historia transakcji">
        <MudTable Items="_transakcje" Dense="true" Hover="true" Striped="true">
            <HeaderContent>
                <MudTh>Czas</MudTh>
                <MudTh>Komponent</MudTh>
                <MudTh>Typ</MudTh>
                <MudTh>Ilość</MudTh>
                <MudTh>Zlecenie</MudTh>
                <MudTh>Notatka</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><MudText Typo="Typo.caption">@context.Timestamp.ToString("dd.MM HH:mm:ss")</MudText></MudTd>
                <MudTd>@context.Materiał</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@TransakcjaColor(context.Typ)">
                        @context.Typ
                    </MudChip>
                </MudTd>
                <MudTd>
                    <MudText Style=@($"font-weight:700;color:{(context.Ilosc >= 0 ? "#66bb6a" : "#ef5350")}")>
                        @(context.Ilosc >= 0 ? "+" : "")@context.Ilosc
                    </MudText>
                </MudTd>
                <MudTd>@(context.Zlecenie ?? "—")</MudTd>
                <MudTd><MudText Typo="Typo.caption" Style="color:var(--text-muted);">@(context.Notatka ?? "—")</MudText></MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Style="padding:20px;color:var(--text-muted);">Brak transakcji.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudTabPanel>
</MudTabs>

<!-- MODAL KOREKTY STANU -->
@if (_korektaOpen && _korektaItem != null)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:1000;display:flex;align-items:center;justify-content:center;"
         @onclick="@(() => _korektaOpen = false)">
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:16px;width:min(420px,92vw);padding:26px;box-shadow:0 24px 64px rgba(0,0,0,0.45);"
             @onclick:stopPropagation>
            <MudText Typo="Typo.h6" Style="font-weight:800;color:var(--text);margin-bottom:6px;">
                Korekta stanu magazynu
            </MudText>
            <MudText Typo="Typo.body2" Style="color:var(--text-muted);margin-bottom:16px;">
                @_korektaItem.NazwaMaterialu
            </MudText>

            <div style="display:flex;gap:18px;margin-bottom:16px;">
                <div>
                    <MudText Typo="Typo.caption" Style="color:var(--text-muted);display:block;">Obecnie</MudText>
                    <MudText Style="font-weight:800;color:var(--text);">@_korektaItem.StanBiezacy szt</MudText>
                </div>
                <div>
                    <MudText Typo="Typo.caption" Style="color:var(--text-muted);display:block;">Maksimum</MudText>
                    <MudText Style="font-weight:800;color:var(--text);">@_korektaItem.IloscBazowa szt</MudText>
                </div>
                @if (_korektaItem.PojemnoscPojemnika > 0)
                {
                    <div>
                        <MudText Typo="Typo.caption" Style="color:var(--text-muted);display:block;">Na pojemnik</MudText>
                        <MudText Style="font-weight:800;color:var(--text);">@_korektaItem.PojemnoscPojemnika szt</MudText>
                    </div>
                }
            </div>

            <MudNumericField T="int" @bind-Value="_korektaIlosc" Label="Nowy stan (szt)"
                             Variant="Variant.Outlined" Min="0" Max="@_korektaItem.IloscBazowa"
                             HelperText="@($"Zakres 0 – {_korektaItem.IloscBazowa} szt (nie można przekroczyć maksimum)")" />

            <div style="display:flex;gap:8px;justify-content:space-between;margin-top:20px;">
                <MudButton Variant="Variant.Text" Color="Color.Primary"
                           OnClick="@(() => _korektaIlosc = _korektaItem.IloscBazowa)">
                    Do stanu maksymalnego
                </MudButton>
                <div style="display:flex;gap:8px;">
                    <MudButton Variant="Variant.Outlined" OnClick="@(() => _korektaOpen = false)">Anuluj</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ZapiszKorekte">Zapisz</MudButton>
                </div>
            </div>
        </div>
    </div>
}

@code {
    List<InventoryItem>       _mainItems    = new();
    List<InventoryTransaction> _transakcje  = new();
    string                    _searchText  = "";
    MudTable<InventoryItem>?  _tableMain;
    System.Timers.Timer?      _timer;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn || !Auth.CurrentUser!.IsSupervisor)
        { Nav.NavigateTo("/login"); return; }

        await LoadAll();
        _timer = new System.Timers.Timer(10000);
        _timer.Elapsed += async (_, _) =>
        {
            if (_disposed) return;
            try
            {
                await LoadAll();
                if (_disposed) return;
                await InvokeAsync(StateHasChanged);
            }
            catch (ObjectDisposedException) { /* strona zamknieta w trakcie odswiezania */ }
            catch (Exception ex) { Console.WriteLine($"[Magazyn] blad odswiezania: {ex.Message}"); }
        };
        _timer.Start();
    }

    async Task LoadAll()
    {
        _mainItems    = await Inv.GetStanMagazynuAsync("MAIN");
        _transakcje   = await Inv.GetTransakcjeAsync();
    }

    bool FilterItem(InventoryItem item) =>
        string.IsNullOrEmpty(_searchText) ||
        item.NazwaMaterialu.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
        item.Wymiary.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
        item.Kolor.Contains(_searchText, StringComparison.OrdinalIgnoreCase);

    // ── Reczna korekta pojedynczego komponentu ───────────────────────
    bool           _korektaOpen;
    InventoryItem? _korektaItem;
    int            _korektaIlosc;

    void OpenKorekta(InventoryItem item)
    {
        _korektaItem  = item;
        _korektaIlosc = item.StanBiezacy;
        _korektaOpen  = true;
    }

    async Task ZapiszKorekte()
    {
        if (_korektaItem == null) return;
        try
        {
            int zapisano = await Inv.UstawStanAsync(_korektaItem.IDMaterialu, _korektaIlosc);
            if (zapisano != _korektaIlosc)
                Snackbar.Add($"Ilość przycięta do maksimum: {zapisano} szt.", Severity.Warning);
            else
                Snackbar.Add($"Stan zaktualizowany: {zapisano} szt.", Severity.Success);

            _korektaOpen = false;
            await LoadAll();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd korekty: {ex.Message}", Severity.Error);
        }
    }

    async Task PotwierdzenieReset()
    {
        var ok = await DialogService.ShowMessageBox(
            "⚠️ Reset magazynu",
            "Czy na pewno chcesz zresetować stany magazynu do wartości bazowych (15.07.2025)?\nWszystkie aktualne stany zostaną nadpisane.",
            "Tak, resetuj", "Anuluj");
        if (ok == true)
        {
            await Inv.ResetujMagazynAsync(null);
            Snackbar.Add("Magazyn zresetowany do stanu bazowego.", Severity.Warning);
            await LoadAll();
        }
    }

    volatile bool _disposed;

    public void Dispose()
    {
        _disposed = true;
        _timer?.Stop();
        _timer?.Dispose();
    }

    // Jednolite progi stanu magazynowego: <26% = czerwony, <50% = pomaranczowy, reszta zielony.
    static string StanColor(double procent) =>
        procent < 26 ? "#EF4444" : procent < 50 ? "#F59E0B" : "#22C55E";

    static Color StanMudColor(double procent) =>
        procent < 26 ? Color.Error : procent < 50 ? Color.Warning : Color.Success;

    Color TransakcjaColor(string typ) => typ switch
    {
        "Rezerwacja"   => Color.Warning,
        "Zuzycie"      => Color.Error,
        "ZwrotPoNOK"   => Color.Success,
        "ZwrotRezerwy" => Color.Info,
        "ResetMagazynu"=> Color.Secondary,
        "KorektaReczna"=> Color.Primary,
        "Transfer"     => Color.Primary,
        _              => Color.Default
    };

    // Mapowanie kolorów LEGO na CSS (przybliżone)
    static string LegoColor(string kolor) => kolor.ToLower() switch
    {
        "czerwony" or "czerwone"       => "#e3000b",
        "żółty" or "żółte"             => "#f7d117",
        "niebieski" or "niebieskie"    => "#0055a3",
        "zielony" or "zielone"         => "#00853d",
        "jasnozielony" or "jasnozielone" or "jasny zielony" => "#77c063",
        "pomarańczowy" or "pomarańczowe" => "#f47b20",
        "szary"                        => "#9ba1a6",
        "brązowy"                      => "#7b5c3c",
        "czarny"                       => "#27292a",
        "biały"                        => "#f5f5f5",
        "piaskowy"                     => "#d5b97b",
        "jasnobrązowy"                 => "#b58a5e",
        "ciemnozielony" or "ciemnozielone" => "#1e5c36",
        _                              => "#cccccc"
    };
}

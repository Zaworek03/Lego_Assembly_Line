@page "/magazyn"
@inject AuthService Auth
@inject InventoryService Inv
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>Magazyn komponentów — Linia Montażowa</PageTitle>

@if (!Auth.IsLoggedIn) { return; }


<!-- NAGŁÓWEK -->
<div style="display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px;">
    <div style="min-width:0;">
        <MudText Typo="Typo.h4" Style="font-weight:800;color:var(--text);">Magazyn komponentów</MudText>
        <MudText Typo="Typo.body2" Style="color:var(--text-muted);">
            @_mainItems.Count @Odmiana(_mainItems.Count, "pozycja", "pozycje", "pozycji") ·
            @SumaSztuk @Odmiana(SumaSztuk, "klocek", "klocki", "klocków") na stanie
        </MudText>
    </div>
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.RestartAlt"
               Style="color:var(--danger);flex-shrink:0;" OnClick="PotwierdzenieReset">
        Resetuj stan bazowy
    </MudButton>
</div>

@if (Zadluzonych > 0)
{
    <div style="@Karta border-color:var(--danger);display:flex;align-items:center;gap:10px;margin-bottom:12px;">
        <MudIcon Icon="@Icons.Material.Filled.Warning" Style="color:var(--danger);" />
        <MudText Typo="Typo.body2" Style="color:var(--text);">
            <b>Zadłużenie magazynu:</b> @Zadluzonych @Odmiana(Zadluzonych, "pozycja", "pozycje", "pozycji")
            poniżej zera — zlecenia zatwierdzone mimo braków.
        </MudText>
    </div>
}

<!-- PASEK: widok + filtry + szukajka -->
<div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:14px;">
    @foreach (var w in Widoki)
    {
        var aktywny = _widok == w.Klucz;
        <div @onclick="@(() => _widok = w.Klucz)"
             style="@($"display:flex;align-items:center;gap:7px;cursor:pointer;user-select:none;padding:7px 13px;border-radius:11px;background:{(aktywny ? "var(--accent-soft)" : "var(--surface)")};border:1px solid {(aktywny ? "var(--accent)" : "var(--border)")};")">
            <MudIcon Icon="@w.Ikona" Style="@($"font-size:16px;color:{(aktywny ? "var(--accent)" : "var(--text-muted)")};")" />
            <MudText Typo="Typo.body2" Style="@($"font-weight:700;color:{(aktywny ? "var(--accent)" : "var(--text-muted)")};")">@w.Etykieta</MudText>
            @if (w.Licznik is int n)
            {
                <MudText Typo="Typo.caption" Style="font-weight:800;color:var(--text);">@n</MudText>
            }
        </div>
    }

    @if (_widok != "historia")
    {
        <div style="margin-left:auto;min-width:210px;">
            <MudTextField @bind-Value="_searchText" Placeholder="Szukaj klocka..." Immediate="true"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        </div>
    }
</div>

@if (_widok == "historia")
{
    <!-- HISTORIA TRANSAKCJI -->
    <div style="@Karta padding:0;overflow:hidden;">
        <MudTable Items="_transakcje" Dense="true" Hover="true" Elevation="0" Style="background:transparent;">
            <HeaderContent>
                <MudTh>Czas</MudTh>
                <MudTh>Komponent</MudTh>
                <MudTh>Typ</MudTh>
                <MudTh>Ilość</MudTh>
                <MudTh>Zlecenie</MudTh>
                <MudTh>Notatka</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><MudText Typo="Typo.caption" Style="color:var(--text-muted);">@context.Timestamp.ToString("dd.MM HH:mm:ss")</MudText></MudTd>
                <MudTd>@context.Materiał</MudTd>
                <MudTd><span style="@PigulkaTransakcji(context.Typ)">@context.Typ</span></MudTd>
                <MudTd>
                    <MudText Style="@($"font-weight:800;color:{(context.Ilosc >= 0 ? "var(--success)" : "var(--danger)")};")">
                        @(context.Ilosc >= 0 ? "+" : "")@context.Ilosc
                    </MudText>
                </MudTd>
                <MudTd>@(context.Zlecenie ?? "—")</MudTd>
                <MudTd><MudText Typo="Typo.caption" Style="color:var(--text-muted);">@(context.Notatka ?? "—")</MudText></MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Style="padding:18px;color:var(--text-muted);">Brak transakcji.</MudText>
            </NoRecordsContent>
        </MudTable>
    </div>
}
else if (!WidoczneItemy.Any())
{
    <div style="@Karta padding:52px;display:flex;flex-direction:column;align-items:center;gap:8px;text-align:center;">
        <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Style="color:var(--accent);font-size:40px;" />
        <MudText Typo="Typo.h6" Style="font-weight:700;color:var(--text);">Brak komponentów</MudText>
        <MudText Typo="Typo.body2" Style="color:var(--text-muted);">Zmień filtr lub wyczyść wyszukiwanie.</MudText>
    </div>
}
else
{
    <!-- KARTY KOMPONENTÓW -->
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px;">
        @foreach (var m in WidoczneItemy)
        {
            <div style="@Karta display:flex;flex-direction:column;gap:10px;">

                <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;">
                    <div style="display:flex;align-items:center;gap:9px;min-width:0;">
                        <div style="@($"width:22px;height:22px;border-radius:6px;flex-shrink:0;background:{LegoColor(m.Kolor)};border:1px solid rgba(255,255,255,0.14);")"></div>
                        <div style="min-width:0;">
                            <MudText Typo="Typo.body1" Style="font-weight:800;color:var(--text);font-family:monospace;line-height:1.2;">@m.Wymiary</MudText>
                            <MudText Typo="Typo.caption" Style="color:var(--text-muted);display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                @m.Kolor · @m.TypWysokosci
                            </MudText>
                        </div>
                    </div>
                    @if (m.NiskiStan)
                    {
                        <span style="padding:3px 9px;border-radius:8px;font-size:11px;font-weight:800;white-space:nowrap;color:#EF4444;background:#EF44441F;">niski stan</span>
                    }
                </div>

                <div>
                    <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:5px;">
                        <MudText Style="@($"font-size:1.3rem;font-weight:800;line-height:1;color:{(m.NiskiStan ? "var(--danger)" : "var(--text)")};")">
                            @m.StanBiezacy<span style="color:var(--text-muted);font-size:.95rem;font-weight:700;"> szt</span>
                        </MudText>
                        <MudText Typo="Typo.body2" Style="font-weight:800;color:var(--accent);">@m.ProcentPelny.ToString("F0")%</MudText>
                    </div>
                    <div class="@($"pasek-stanu {(m.NiskiStan ? "niski" : "")}")">
                        <i style="@($"width:{Procent(m.ProcentPelny)}%;")"></i>
                    </div>
                </div>

                <div style="display:flex;align-items:center;gap:12px;padding-top:8px;border-top:1px solid var(--border);">
                    <div>
                        <MudText Typo="Typo.caption" Style="color:var(--text-muted);display:block;">Zarezerw.</MudText>
                        <MudText Typo="Typo.body2" Style="@($"font-weight:800;color:{(m.IloscZarezerwowana > 0 ? "var(--warning)" : "var(--text-muted)")};")">@m.IloscZarezerwowana</MudText>
                    </div>
                    <div>
                        <MudText Typo="Typo.caption" Style="color:var(--text-muted);display:block;">Dostępne</MudText>
                        <MudText Typo="Typo.body2" Style="@($"font-weight:800;color:{StanColor(m.ProcentDostepny)};")">@m.Dostepny</MudText>
                    </div>
                    <div style="margin-left:auto;">
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Tune"
                                   OnClick="@(() => OpenKorekta(m))">
                            Uzupełnij
                        </MudButton>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- MODAL KOREKTY STANU -->
@if (_korektaOpen && _korektaItem != null)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:1000;display:flex;align-items:center;justify-content:center;"
         @onclick="@(() => _korektaOpen = false)">
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:16px;width:min(420px,92vw);padding:26px;box-shadow:0 24px 64px rgba(0,0,0,0.45);"
             @onclick:stopPropagation>
            <MudText Typo="Typo.h6" Style="font-weight:800;color:var(--text);margin-bottom:6px;">
                Korekta stanu magazynu
            </MudText>
            <MudText Typo="Typo.body2" Style="color:var(--text-muted);margin-bottom:16px;">
                @_korektaItem.NazwaMaterialu
            </MudText>

            <div style="display:flex;gap:18px;margin-bottom:16px;">
                <div>
                    <MudText Typo="Typo.caption" Style="color:var(--text-muted);display:block;">Obecnie</MudText>
                    <MudText Style="font-weight:800;color:var(--text);">@_korektaItem.StanBiezacy szt</MudText>
                </div>
                <div>
                    <MudText Typo="Typo.caption" Style="color:var(--text-muted);display:block;">Maksimum</MudText>
                    <MudText Style="font-weight:800;color:var(--text);">@_korektaItem.IloscBazowa szt</MudText>
                </div>
                @if (_korektaItem.PojemnoscPojemnika > 0)
                {
                    <div>
                        <MudText Typo="Typo.caption" Style="color:var(--text-muted);display:block;">Na pojemnik</MudText>
                        <MudText Style="font-weight:800;color:var(--text);">@_korektaItem.PojemnoscPojemnika szt</MudText>
                    </div>
                }
            </div>

            <MudNumericField T="int" @bind-Value="_korektaIlosc" Label="Nowy stan (szt)"
                             Variant="Variant.Outlined" Min="0" Max="@_korektaItem.IloscBazowa"
                             HelperText="@($"Zakres 0 – {_korektaItem.IloscBazowa} szt (nie można przekroczyć maksimum)")" />

            <div style="display:flex;gap:8px;justify-content:space-between;margin-top:20px;">
                <MudButton Variant="Variant.Text" Color="Color.Primary"
                           OnClick="@(() => _korektaIlosc = _korektaItem.IloscBazowa)">
                    Do stanu maksymalnego
                </MudButton>
                <div style="display:flex;gap:8px;">
                    <MudButton Variant="Variant.Outlined" OnClick="@(() => _korektaOpen = false)">Anuluj</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ZapiszKorekte">Zapisz</MudButton>
                </div>
            </div>
        </div>
    </div>
}

@code {
    List<InventoryItem>       _mainItems    = new();
    List<InventoryTransaction> _transakcje  = new();
    string                    _searchText  = "";
    System.Timers.Timer?      _timer;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn || !Auth.CurrentUser!.IsSupervisor)
        { Nav.NavigateTo("/login"); return; }

        await LoadAll();
        _timer = new System.Timers.Timer(10000);
        _timer.Elapsed += async (_, _) =>
        {
            if (_disposed) return;
            try
            {
                await LoadAll();
                if (_disposed) return;
                await InvokeAsync(StateHasChanged);
            }
            catch (ObjectDisposedException) { /* strona zamknieta w trakcie odswiezania */ }
            catch (Exception ex) { Console.WriteLine($"[Magazyn] blad odswiezania: {ex.Message}"); }
        };
        _timer.Start();
    }

    async Task LoadAll()
    {
        _mainItems    = await Inv.GetStanMagazynuAsync("MAIN");
        _transakcje   = await Inv.GetTransakcjeAsync();
    }

    bool FilterItem(InventoryItem item) =>
        string.IsNullOrEmpty(_searchText) ||
        item.NazwaMaterialu.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
        item.Wymiary.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
        item.Kolor.Contains(_searchText, StringComparison.OrdinalIgnoreCase);

    // ── Widok i filtry (styl jak w zakladce Zlecenia) ────────────────
    /// <summary>Kafelek w tym samym stylu co bloki na pulpicie i karty zlecen.</summary>
    const string Karta = "background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:15px;";

    string _widok = "wszystkie";

    record WidokPozycja(string Klucz, string Etykieta, string Ikona, int? Licznik);

    IEnumerable<WidokPozycja> Widoki => new[]
    {
        new WidokPozycja("wszystkie", "Wszystkie",   Icons.Material.Outlined.Inventory2, _mainItems.Count),
        new WidokPozycja("niskie",    "Niski stan",  Icons.Material.Outlined.Warning,    _mainItems.Count(i => i.NiskiStan)),
        new WidokPozycja("historia",  "Historia",    Icons.Material.Outlined.History,    null),
    };

    IEnumerable<InventoryItem> WidoczneItemy =>
        _mainItems.Where(FilterItem)
                  .Where(i => _widok != "niskie" || i.NiskiStan)
                  .OrderBy(i => i.ProcentPelny);

    int SumaSztuk    => _mainItems.Sum(i => i.StanBiezacy);
    int Zadluzonych  => _mainItems.Count(i => i.Dostepny < 0);

    /// <summary>Szerokosc paska w procentach, zawsze z kropka dziesietna (CSS nie zna przecinka).</summary>
    static string Procent(double v) =>
        Math.Clamp(v, 0, 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>Polska odmiana przez liczbe: 1 pozycja, 2 pozycje, 5 pozycji.</summary>
    static string Odmiana(int n, string poj, string mnogaMala, string mnogaDuza)
    {
        if (n == 1) return poj;
        int dziesiatki = n % 100, jednosci = n % 10;
        bool mala = jednosci is >= 2 and <= 4 && dziesiatki is < 12 or > 14;
        return mala ? mnogaMala : mnogaDuza;
    }

    /// <summary>Pigulka typu transakcji - ten sam jezyk co pigulki statusu zlecen.</summary>
    static string PigulkaTransakcji(string typ)
    {
        var c = typ switch
        {
            "Rezerwacja"    => "#F59E0B",
            "Zuzycie"       => "#EF4444",
            "ZwrotPoNOK"    => "#22C55E",
            "ZwrotRezerwy"  => "#38BDF8",
            "ResetMagazynu" => "#8B8B93",
            _               => "#FF6A3D"
        };
        return $"display:inline-block;padding:3px 9px;border-radius:8px;font-size:11px;" +
               $"font-weight:800;white-space:nowrap;color:{c};background:{c}1F;";
    }

    // ── Reczna korekta pojedynczego komponentu ───────────────────────
    bool           _korektaOpen;
    InventoryItem? _korektaItem;
    int            _korektaIlosc;

    void OpenKorekta(InventoryItem item)
    {
        _korektaItem  = item;
        _korektaIlosc = item.StanBiezacy;
        _korektaOpen  = true;
    }

    async Task ZapiszKorekte()
    {
        if (_korektaItem == null) return;
        try
        {
            int zapisano = await Inv.UstawStanAsync(_korektaItem.IDMaterialu, _korektaIlosc);
            if (zapisano != _korektaIlosc)
                Snackbar.Add($"Ilość przycięta do maksimum: {zapisano} szt.", Severity.Warning);
            else
                Snackbar.Add($"Stan zaktualizowany: {zapisano} szt.", Severity.Success);

            _korektaOpen = false;
            await LoadAll();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd korekty: {ex.Message}", Severity.Error);
        }
    }

    async Task PotwierdzenieReset()
    {
        var ok = await DialogService.ShowMessageBox(
            "⚠️ Reset magazynu",
            "Czy na pewno chcesz zresetować stany magazynu do wartości bazowych (15.07.2025)?\nWszystkie aktualne stany zostaną nadpisane.",
            "Tak, resetuj", "Anuluj");
        if (ok == true)
        {
            await Inv.ResetujMagazynAsync(null);
            Snackbar.Add("Magazyn zresetowany do stanu bazowego.", Severity.Warning);
            await LoadAll();
        }
    }

    volatile bool _disposed;

    public void Dispose()
    {
        _disposed = true;
        _timer?.Stop();
        _timer?.Dispose();
    }

    // Jednolite progi stanu magazynowego: <26% = czerwony, <50% = pomaranczowy, reszta zielony.
    static string StanColor(double procent) =>
        procent < 26 ? "#EF4444" : procent < 50 ? "#F59E0B" : "#22C55E";

    static Color StanMudColor(double procent) =>
        procent < 26 ? Color.Error : procent < 50 ? Color.Warning : Color.Success;

    Color TransakcjaColor(string typ) => typ switch
    {
        "Rezerwacja"   => Color.Warning,
        "Zuzycie"      => Color.Error,
        "ZwrotPoNOK"   => Color.Success,
        "ZwrotRezerwy" => Color.Info,
        "ResetMagazynu"=> Color.Secondary,
        "KorektaReczna"=> Color.Primary,
        "Transfer"     => Color.Primary,
        _              => Color.Default
    };

    // Mapowanie kolorów LEGO na CSS (przybliżone)
    static string LegoColor(string kolor) => kolor.ToLower() switch
    {
        "czerwony" or "czerwone"       => "#e3000b",
        "żółty" or "żółte"             => "#f7d117",
        "niebieski" or "niebieskie"    => "#0055a3",
        "zielony" or "zielone"         => "#00853d",
        "jasnozielony" or "jasnozielone" or "jasny zielony" => "#77c063",
        "pomarańczowy" or "pomarańczowe" => "#f47b20",
        "szary"                        => "#9ba1a6",
        "brązowy"                      => "#7b5c3c",
        "czarny"                       => "#27292a",
        "biały"                        => "#f5f5f5",
        "piaskowy"                     => "#d5b97b",
        "jasnobrązowy"                 => "#b58a5e",
        "ciemnozielony" or "ciemnozielone" => "#1e5c36",
        _                              => "#cccccc"
    };
}

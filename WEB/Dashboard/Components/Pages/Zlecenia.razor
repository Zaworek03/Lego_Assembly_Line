@page "/zlecenia"
@inject AuthService Auth
@inject OrderService Orders
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>Zlecenia — Linia Montażowa</PageTitle>

@if (!Auth.IsLoggedIn) { return; }


<!-- NAGŁÓWEK -->
<div style="display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px;">
    <div style="min-width:0;">
        <MudText Typo="Typo.h4" Style="font-weight:800;color:var(--text);">Zlecenia produkcyjne</MudText>
        <MudText Typo="Typo.body2" Style="color:var(--text-muted);">
            @_zlecenia.Count @Odmiana(_zlecenia.Count, "zlecenie", "zlecenia", "zleceń") ·
            @SumaSztuk @Odmiana(SumaSztuk, "sztuka", "sztuki", "sztuk") w planie
        </MudText>
    </div>
    <div style="display:flex;gap:8px;flex-shrink:0;">
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.DeleteSweep"
                   Style="color:var(--danger);" OnClick="PotwierdzenieWyczysc">
            Wyczyść
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateModal">
            Nowe zlecenie
        </MudButton>
    </div>
</div>

<!-- FILTRY: pigulki z licznikiem, w stylu kafelkow z pulpitu -->
<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;">
    @foreach (var f in Filtry)
    {
        var aktywny = _filterStatus == f.Status;
        <div @onclick="@(() => SetFilter(f.Status))"
             style="@($"display:flex;align-items:center;gap:7px;cursor:pointer;user-select:none;padding:7px 13px;border-radius:11px;background:{(aktywny ? "var(--accent-soft)" : "var(--surface)")};border:1px solid {(aktywny ? "var(--accent)" : "var(--border)")};")">
            <span style="@($"width:7px;height:7px;border-radius:50%;background:{StatusColor(f.Status)};")"></span>
            <MudText Typo="Typo.body2" Style="@($"font-weight:700;color:{(aktywny ? "var(--accent)" : "var(--text-muted)")};")">@f.Etykieta</MudText>
            <MudText Typo="Typo.caption" Style="font-weight:800;color:var(--text);">@Ile(f.Status)</MudText>
        </div>
    }
</div>

<!-- KARTY ZLECEŃ -->
@if (!FilteredZlecenia.Any())
{
    <div style="@Karta padding:52px;display:flex;flex-direction:column;align-items:center;gap:8px;text-align:center;">
        <MudIcon Icon="@Icons.Material.Outlined.Assignment" Style="color:var(--accent);font-size:40px;" />
        <MudText Typo="Typo.h6" Style="font-weight:700;color:var(--text);">Brak zleceń</MudText>
        <MudText Typo="Typo.body2" Style="color:var(--text-muted);">
            @(_filterStatus is null ? "Użyj przycisku „Nowe zlecenie”, aby dodać pierwsze." : "Zmień filtr, aby zobaczyć pozostałe.")
        </MudText>
    </div>
}
else
{
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:12px;">
        @foreach (var z in FilteredZlecenia)
        {
            <div style="@Karta display:flex;flex-direction:column;gap:10px;">

                <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;">
                    <div style="min-width:0;">
                        <MudText Typo="Typo.h6" Style="font-weight:800;color:var(--text);line-height:1.2;">@z.NazwaZlecenia</MudText>
                        <MudText Typo="Typo.caption" Style="color:var(--text-muted);display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                            @(z.NazwaWyrobu ?? "—")
                        </MudText>
                    </div>
                    <div style="display:flex;align-items:center;gap:4px;flex-shrink:0;">
                        <span style="@($"padding:3px 9px;border-radius:8px;font-size:11px;font-weight:800;color:{StatusColor(z.StatusZlecenia)};background:{StatusColor(z.StatusZlecenia)}1F;")">
                            @z.StatusZlecenia
                        </span>
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                            <MudMenuItem Icon="@Icons.Material.Filled.Visibility" OnClick="@(() => OpenDetailModal(z))">Szczegóły</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => OpenEditModal(z))">Edytuj</MudMenuItem>
                            @if (z.WToku)
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.Stop" OnClick="@(() => ZmienStatus(z, "Zakonczone"))">Zakończ ręcznie</MudMenuItem>
                            }
                            <MudDivider />
                            <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="@(() => PotwierdzenieUsun(z))">
                                <MudText Color="Color.Error">Usuń zlecenie</MudText>
                            </MudMenuItem>
                        </MudMenu>
                    </div>
                </div>

                <div>
                    <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:5px;">
                        <MudText Style="font-size:1.3rem;font-weight:800;color:var(--text);line-height:1;">
                            @z.Rozliczone<span style="color:var(--text-muted);font-size:.95rem;font-weight:700;"> / @z.IloscSztuk szt</span>
                        </MudText>
                        <MudText Typo="Typo.body2" Style="font-weight:800;color:var(--accent);">@z.PostepProcent.ToString("F0")%</MudText>
                    </div>
                    <MudProgressLinear Value="@z.PostepProcent" Rounded="true" Size="Size.Small"
                                       Style="background:var(--track);" Color="Color.Primary" />
                </div>

                <div style="display:flex;align-items:center;gap:14px;padding-top:8px;border-top:1px solid var(--border);">
                    <div>
                        <MudText Typo="Typo.caption" Style="color:var(--text-muted);display:block;">OK</MudText>
                        <MudText Typo="Typo.body2" Style="font-weight:800;color:var(--success);">@z.SztukOK</MudText>
                    </div>
                    <div>
                        <MudText Typo="Typo.caption" Style="color:var(--text-muted);display:block;">NOK</MudText>
                        <MudText Typo="Typo.body2" Style="@($"font-weight:800;color:{(z.SztukNOK > 0 ? "var(--danger)" : "var(--text-muted)")};")">@z.SztukNOK</MudText>
                    </div>
                    <div style="margin-left:auto;text-align:right;min-width:0;">
                        <MudText Typo="Typo.caption" Style="color:var(--text-muted);display:block;">Priorytet</MudText>
                        <MudText Typo="Typo.caption" Style="font-weight:800;color:var(--text);">@z.Priorytet</MudText>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- ==================== MODAL TWORZENIA / EDYCJI ==================== -->
@if (_modalOpen)
{
    <!-- Overlay -->
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:1000;display:flex;align-items:center;justify-content:center;"
         @onclick="CloseModal">
        <!-- Panel modalny (zatrzymaj propagację kliknięcia) -->
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:16px;width:min(640px,95vw);max-height:90vh;overflow-y:auto;box-shadow:0 24px 64px rgba(0,0,0,0.45);position:relative;"
             @onclick:stopPropagation>
            <!-- Nagłówek modalu -->
            <div style="padding:24px 28px 0;display:flex;justify-content:space-between;align-items:center;">
                <MudText Typo="Typo.h5" Style="font-weight:800;color:var(--text);">
                    @(_editId.HasValue ? "Edytuj zlecenie" : "Nowe zlecenie produkcyjne")
                </MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseModal"
                               Size="Size.Small" Style="color:var(--text-muted);" />
            </div>
            <MudDivider Class="mt-3 mb-0" />

            <!-- Ciało formularza -->
            <div style="padding:24px 28px;">

                <!-- Błędy walidacji dostępności komponentów -->
                @if (_walidacjaBraki != null && _walidacjaBraki.Braki.Any())
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4" Dense="false">
                        <b>Brak wystarczającej ilości komponentów!</b>
                        <p style="margin:8px 0 4px;">Maksymalna możliwa ilość przy obecnym stanie magazynu:
                            <b style="color:#d32f2f;">@_walidacjaBraki.MaxMozliwaIlosc szt</b>
                        </p>
                        <table style="font-size:12px;border-collapse:collapse;width:100%;">
                            <tr style="background:rgba(239,68,68,0.14);">
                                <th style="padding:4px 8px;text-align:left;">Komponent</th>
                                <th style="padding:4px 8px;">Wymaga</th>
                                <th style="padding:4px 8px;">Dostępne</th>
                                <th style="padding:4px 8px;color:#d32f2f;">Brakuje</th>
                            </tr>
                            @foreach (var b in _walidacjaBraki.Braki)
                            {
                                <tr>
                                    <td style="padding:3px 8px;">@b.NazwaMaterialu (@b.Wymiary, @b.Kolor)</td>
                                    <td style="padding:3px 8px;text-align:center;">@b.IloscWymagana</td>
                                    <td style="padding:3px 8px;text-align:center;">@b.IloscDostepna</td>
                                    <td style="padding:3px 8px;text-align:center;color:#d32f2f;font-weight:700;">@b.IloscBrakujaca</td>
                                </tr>
                            }
                        </table>
                        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                       OnClick="@(() => { _fIlosc = _walidacjaBraki.MaxMozliwaIlosc; _walidacjaBraki = null; })">
                                Ustaw max możliwą ilość (@_walidacjaBraki.MaxMozliwaIlosc szt)
                            </MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.Warning"
                                       Disabled="_saving"
                                       OnClick="@(() => SaveModal(ignorujBraki: true))">
                                Zatwierdź mimo braków
                            </MudButton>
                        </div>
                        <MudText Typo="Typo.caption" Style="display:block;margin-top:6px;color:var(--text-muted);">
                            Zatwierdzenie mimo braków wprowadzi magazyn w zadłużenie — ilość dostępna
                            tych komponentów spadnie poniżej zera.
                        </MudText>
                    </MudAlert>
                }

                <MudGrid Spacing="3">
                    <!-- SKU / Wyrób -->
                    <MudItem xs="12">
                        <MudSelect T="int?" @bind-Value="_fIdWyrobu" Label="Wyrób gotowy (SKU) *"
                                   Variant="Variant.Outlined" Required="true"
                                   HelperText="Wybierz wyrób z listy">
                            @foreach (var w in _wyroby)
                            {
                                <MudSelectItem Value="(int?)w.ID">@w.Nazwa</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <!-- Ilość -->
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="int" @bind-Value="_fIlosc"
                                         Label="Wielkość partii (szt) *"
                                         Variant="Variant.Outlined" Min="1" Max="10" Required="true"
                                         HelperText="Liczba sztuk do wyprodukowania" />
                    </MudItem>

                    <!-- Priorytet -->
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" @bind-Value="_fPriorytet" Label="Priorytet *"
                                   Variant="Variant.Outlined">
                            @foreach (var p in Priorytety.Wszystkie)
                            {
                                <MudSelectItem Value="p">@p</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                <!-- Walidacja inline -->
                @if (_formErrors.Any())
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-3" Dense="true">
                        @foreach (var e in _formErrors) { <div>• @e</div> }
                    </MudAlert>
                }
            </div>

            <!-- Stopka -->
            <div style="padding:16px 28px 24px;display:flex;justify-content:space-between;align-items:center;">
                @if (_editId.HasValue)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Delete"
                               OnClick="@(() => PotwierdzenieUsunZEdycji(_editId.Value))">
                        Usuń zlecenie
                    </MudButton>
                }
                else
                {
                    <span></span>
                }
                <div style="display:flex;gap:8px;">
                    <MudButton Variant="Variant.Outlined" OnClick="CloseModal" Disabled="_saving">Anuluj</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="@(() => SaveModal())" Disabled="_saving"
                               StartIcon="@Icons.Material.Filled.Save">
                        @(_saving ? "Zapisuję..." : "Zapisz zlecenie")
                    </MudButton>
                </div>
            </div>
        </div>
    </div>
}

<!-- ==================== MODAL SZCZEGÓŁÓW ==================== -->
@* Sam modal mieszka w Components/SzczegolyZlecenia.razor - dokladnie
   ten sam podglad otwiera sie teraz takze na pulpicie. *@
@if (_detailOpen)
{
    <SzczegolyZlecenia Detail="@_detail" OnClose="@(() => _detailOpen = false)" />
}

@code {
    List<ZlecenieVM>     _zlecenia     = new();
    List<SelectItem>     _wyroby       = new();
    string?              _filterStatus;
    System.Timers.Timer? _timer;

    // Stan modalu tworzenia/edycji
    bool                    _modalOpen = false;
    bool                    _saving    = false;
    int?                    _editId;
    WalidacjaKomponentow?   _walidacjaBraki;
    List<string>            _formErrors = new();

    // Pola formularza
    string   _fNazwa     = "";
    int      _fIlosc     = 1;
    int?     _fIdWyrobu;
    string   _fPriorytet = Priorytety.P3;

    // Stan modalu szczegółów
    bool           _detailOpen = false;
    ZlecenieDetail? _detail;

    IEnumerable<ZlecenieVM> FilteredZlecenia =>
        _filterStatus == null
            ? _zlecenia
            : _zlecenia.Where(z => z.StatusZlecenia == _filterStatus);

    void SetFilter(string? v) => _filterStatus = v;

    /// <summary>Zlecenie wskazane w adresie (?szczegoly=N) - przyjscie z pulpitu.</summary>
    [SupplyParameterFromQuery(Name = "szczegoly")]
    public int? SzczegolyZQueryString { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn || !Auth.CurrentUser!.IsSupervisor)
        { Nav.NavigateTo("/login"); return; }

        _wyroby = await Orders.GetWyrobyAsync();
        await LoadData();

        // Wejscie z pulpitu (klikniecie wiersza w "Ostatnich zleceniach") od razu
        // otwiera szczegoly - modal jest tutaj, wiec nie duplikujemy go tam.
        if (SzczegolyZQueryString is int id)
        {
            var z = _zlecenia.FirstOrDefault(x => x.IDZlecenia == id);
            if (z != null) await OpenDetailModal(z);
        }
        _timer  = new System.Timers.Timer(1000);   // statusy zlecen zmieniaja sie z HMI - 5 s bylo odczuwalne
        _timer.Elapsed += async (_, _) =>
        {
            if (_disposed) return;
            try
            {
                await LoadData();
                if (_disposed) return;
                await InvokeAsync(StateHasChanged);
            }
            catch (ObjectDisposedException) { /* strona zamknieta w trakcie odswiezania */ }
            catch (Exception ex) { Console.WriteLine($"[Zlecenia] blad odswiezania: {ex.Message}"); }
        };
        _timer.Start();
    }

    async Task LoadData()
    {
        var stareStatusy = _zlecenia.ToDictionary(z => z.IDZlecenia, z => z.StatusZlecenia);
        _zlecenia = await Orders.GetZleceniaAsync();

        foreach (var z in _zlecenia)
        {
            if (stareStatusy.TryGetValue(z.IDZlecenia, out var stary)
                && stary == "W toku" && z.StatusZlecenia == "Zakonczone")
            {
                Snackbar.Add($"Zlecenie '{z.NazwaZlecenia}' ukonczone! ({z.IloscSztuk} szt.)",
                    Severity.Success, cfg => { cfg.VisibleStateDuration = 7000; cfg.ShowCloseIcon = true; });
            }
        }
    }

    // ── Modal tworzenia ──────────────────────────────────────────────
    void OpenCreateModal()
    {
        _editId      = null;
        _fNazwa     = ""; // nadawana automatycznie po zapisie, sprzezona z ID_Zlecenia (ZLxxx)
        _fIlosc     = 1;
        _fIdWyrobu   = _wyroby.FirstOrDefault()?.ID;
        _fPriorytet  = Priorytety.P3;
        _formErrors  = new();
        _walidacjaBraki = null;
        _modalOpen   = true;
    }

    void OpenEditModal(ZlecenieVM z)
    {
        _editId      = z.IDZlecenia;
        _fNazwa      = z.NazwaZlecenia;
        _fIlosc      = z.IloscSztuk;
        _fIdWyrobu   = z.IDWyrobu;
        _fPriorytet  = z.Priorytet;
        _formErrors  = new();
        _walidacjaBraki = null;
        _modalOpen   = true;
    }

    void CloseModal()
    {
        _modalOpen      = false;
        _walidacjaBraki = null;
        _formErrors     = new();
    }

    async Task SaveModal(bool ignorujBraki = false)
    {
        _formErrors  = new();
        if (!ignorujBraki) _walidacjaBraki = null;

        // Walidacja pól
        if (_fIdWyrobu == null)   _formErrors.Add("Wybierz wyrób (SKU).");
        if (_fIlosc < 1)          _formErrors.Add("Wielkość partii musi być ≥ 1.");
        if (_formErrors.Any()) return;
        _saving = true;
        StateHasChanged();

        try
        {
            if (_editId.HasValue)
            {
                var err = await Orders.EditZlecenieAsync(_editId.Value, _fNazwa, _fIlosc, _fIdWyrobu!.Value, _fPriorytet);
                if (err != null) { _walidacjaBraki = err; return; }
                Snackbar.Add("Zlecenie zaktualizowane!", Severity.Success);
            }
            else
            {
                var (id, err) = await Orders.CreateZlecenieAsync(_fNazwa, _fIlosc, _fIdWyrobu!.Value, _fPriorytet, ignorujBraki);
                if (err != null) { _walidacjaBraki = err; return; }

                if (ignorujBraki)
                    Snackbar.Add($"Zlecenie 'ZL{id:D3}' utworzone mimo braków — magazyn w zadłużeniu.",
                                 Severity.Warning, cfg => cfg.VisibleStateDuration = 7000);
                else
                    Snackbar.Add($"Zlecenie 'ZL{id:D3}' utworzone!", Severity.Success);

                _walidacjaBraki = null;
            }

            _modalOpen = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd zapisu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    // ── Modal szczegółów ────────────────────────────────────────────
    async Task OpenDetailModal(ZlecenieVM z)
    {
        _detail     = await Orders.GetZlecenieDetailAsync(z.IDZlecenia);
        _detailOpen = true;
    }

    // ── Usuwanie ────────────────────────────────────────────────────
    async Task PotwierdzenieUsun(ZlecenieVM z)
    {
        var ok = await DialogService.ShowMessageBox(
            "Usuń zlecenie",
            $"Czy na pewno chcesz usunąć zlecenie '{z.NazwaZlecenia}'?\nZostanie ono archiwizowane (soft-delete). Zarezerwowane materiały zostaną zwrócone.",
            "Usuń", "Anuluj");
        if (ok == true)
        {
            await Orders.SoftDeleteAsync(z.IDZlecenia);
            Snackbar.Add("Zlecenie usunięte.", Severity.Warning);
            await LoadData();
        }
    }

    async Task PotwierdzenieUsunZEdycji(int id)
    {
        CloseModal();
        var z = _zlecenia.FirstOrDefault(x => x.IDZlecenia == id);
        if (z != null) await PotwierdzenieUsun(z);
    }

    async Task PotwierdzenieWyczysc()
    {
        var ok = await DialogService.ShowMessageBox(
            "⚠️ Wyczyść wszystkie zlecenia",
            "Czy na pewno chcesz usunąć WSZYSTKIE zlecenia?\n\nTej operacji nie można cofnąć. Wszystkie zarezerwowane materiały zostaną zwrócone do magazynu.",
            "Tak, wyczyść wszystkie", "Anuluj");
        if (ok == true)
        {
            await Orders.ClearAllAsync();
            Snackbar.Add("Wszystkie zlecenia wyczyszczone.", Severity.Error);
            await LoadData();
        }
    }

    // ── Zmiana statusu (quick action) ───────────────────────────────
    async Task ZmienStatus(ZlecenieVM z, string status)
    {
        await Orders.UpdateStatusAsync(z.IDZlecenia, status);
        await LoadData();
        Snackbar.Add($"Status zmieniony na: {status}", Severity.Info);
    }

    volatile bool _disposed;

    public void Dispose()
    {
        _disposed = true;
        _timer?.Stop();
        _timer?.Dispose();
    }

    // ── Style helpers ────────────────────────────────────────────────
    /// <summary>Kafelek w tym samym stylu co bloki na pulpicie.</summary>
    const string Karta = "background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:15px;";

    record FiltrPozycja(string Etykieta, string? Status);

    static readonly FiltrPozycja[] Filtry =
    {
        new("Wszystkie",  null),
        new("Nowe",       "Nowe"),
        new("W toku",     "W toku"),
        new("Zakończone", "Zakonczone"),
        new("Anulowane",  "Anulowane"),
    };

    int Ile(string? status) =>
        status is null ? _zlecenia.Count : _zlecenia.Count(z => z.StatusZlecenia == status);

    int SumaSztuk => _zlecenia.Sum(z => z.IloscSztuk);

    /// <summary>Polska odmiana przez liczbe: 1 zlecenie, 2 zlecenia, 5 zlecen.</summary>
    static string Odmiana(int n, string poj, string mnogaMala, string mnogaDuza)
    {
        if (n == 1) return poj;
        int dziesiatki = n % 100, jednosci = n % 10;
        bool mala = jednosci is >= 2 and <= 4 && dziesiatki is < 12 or > 14;
        return mala ? mnogaMala : mnogaDuza;
    }

    // null = filtr "Wszystkie", wiec kolor neutralny zamiast statusowego.
    string StatusColor(string? s) => s switch
    {
        null         => "#8B8B93",
        "W toku"     => "#FF6A3D",
        "Zakonczone" => "#22C55E",
        "Anulowane"  => "#EF4444",
        _            => "#F59E0B"
    };

    Color StatusMudColor(string s) => s switch
    {
        "W toku"     => Color.Primary,
        "Zakonczone" => Color.Success,
        "Wstrzymane" => Color.Secondary,
        _            => Color.Warning
    };

    Color PriorytetColor(string p) => p switch
    {
        Priorytety.P5 => Color.Error,
        Priorytety.P4 => Color.Warning,
        Priorytety.P3 => Color.Primary,
        Priorytety.P2 => Color.Info,
        _             => Color.Default
    };
}







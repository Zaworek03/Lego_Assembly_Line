@page "/harmonogram"
@inject AuthService Auth
@inject ProductionDataService Svc
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Harmonogram — Linia Montażowa</PageTitle>
@if (!Auth.IsLoggedIn) { return; }


<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
    <MudText Typo="Typo.h4" Style="font-weight:700;color:#1a2035;">Harmonogram zmiany</MudText>
    <MudText Typo="Typo.body1" Style="color:#666;">@DateTime.Today.ToString("dd.MM.yyyy")</MudText>
</div>

<MudGrid Spacing="3">
    <MudItem xs="12" md="8">
        <MudPaper Elevation="2" Style="border-radius:12px;overflow:hidden;">
            <div style="padding:16px 24px;border-bottom:1px solid #eee;">
                <MudText Typo="Typo.h6" Style="font-weight:600;">Dzisiejsza zmiana</MudText>
            </div>
            <MudTable Items="_harmonogram" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Stanowisko</MudTh>
                    <MudTh>Operator</MudTh>
                    <MudTh>Zlecenie</MudTh>
                    <MudTh>Od</MudTh>
                </HeaderContent>
                <RowTemplate Context="h">
                    <MudTd><b>@h.Stanowisko</b></MudTd>
                    <MudTd>@h.Operator</MudTd>
                    <MudTd>@h.NazwaZlecenia</MudTd>
                    <MudTd>@(h.CzasRozp?.ToString("HH:mm") ?? "—")</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Style="padding:20px;color:#999;">Brak wpisów na dziś.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Elevation="2" Style="padding:24px;border-radius:12px;">
            <MudText Typo="Typo.h6" Style="font-weight:600;margin-bottom:20px;">Przypisz operatora</MudText>

            <MudSelect T="int" @bind-Value="_selZlecenie" Label="Zlecenie" Variant="Variant.Outlined"
                       FullWidth="true" Class="mb-3">
                @foreach (var z in _zlecenia)
                {
                    <MudSelectItem Value="z.ID">@z.Nazwa</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="int" @bind-Value="_selStanowisko" Label="Stanowisko" Variant="Variant.Outlined"
                       FullWidth="true" Class="mb-3">
                @foreach (var s in _stanowiska)
                {
                    <MudSelectItem Value="s.ID">@s.Nazwa</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="int" @bind-Value="_selOperator" Label="Operator" Variant="Variant.Outlined"
                       FullWidth="true" Class="mb-4">
                @foreach (var o in _operatory)
                {
                    <MudSelectItem Value="o.ID">@o.Nazwa</MudSelectItem>
                }
            </MudSelect>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       OnClick="DodajWpis">
                Dodaj do harmonogramu
            </MudButton>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    List<HarmonogramRow> _harmonogram = new();
    List<SelectItem> _zlecenia   = new();
    List<SelectItem> _stanowiska = new();
    List<SelectItem> _operatory  = new();

    int _selZlecenie = 0, _selStanowisko = 0, _selOperator = 0;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn || !Auth.CurrentUser!.IsSupervisor)
        { Nav.NavigateTo("/login"); return; }

        _harmonogram = await Svc.GetHarmonogramDzisAsync();
        _zlecenia    = await Svc.GetZleceniaAsync().ContinueWith(t =>
            t.Result.Select(z => new SelectItem { ID = z.IDZlecenia, Nazwa = z.NazwaZlecenia }).ToList());
        _stanowiska  = await Svc.GetStanowiskaAsync();
        _operatory   = await Svc.GetOperatoryAsync();
        if (_zlecenia.Count    > 0) _selZlecenie   = _zlecenia[0].ID;
        if (_stanowiska.Count  > 0) _selStanowisko = _stanowiska[0].ID;
        if (_operatory.Count   > 0) _selOperator   = _operatory[0].ID;
    }

    async Task DodajWpis()
    {
        if (_selZlecenie == 0 || _selStanowisko == 0 || _selOperator == 0)
        {
            Snackbar.Add("Wybierz zlecenie, stanowisko i operatora.", Severity.Warning);
            return;
        }
        await Svc.AddHarmonogramAsync(_selZlecenie, _selStanowisko, _selOperator);
        _harmonogram = await Svc.GetHarmonogramDzisAsync();
        Snackbar.Add("Dodano do harmonogramu!", Severity.Success);
    }
}

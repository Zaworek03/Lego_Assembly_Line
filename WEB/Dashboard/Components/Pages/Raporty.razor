@page "/raporty"
@inject AuthService Auth

<PageTitle>Raporty — Linia Montażowa</PageTitle>

@if (!Auth.IsLoggedIn) { return; }

<div style="background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:60px;
            display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:12px;margin-top:40px;">
    <MudIcon Icon="@Icons.Material.Filled.BarChart" Style="color:var(--accent);font-size:48px;" />
    <MudText Typo="Typo.h5" Style="font-weight:700;color:var(--text);">Raporty — w budowie</MudText>
    <MudText Typo="Typo.body2" Style="color:var(--text-muted);max-width:420px;">
        Ta zakładka zostanie zaprojektowana osobno.
    </MudText>
</div>

@page "/raporty"
@inject AuthService Auth
@inject OrderService Orders
@inject ProductionDataService Svc
@inject NavigationManager Nav
@using System.Globalization

<PageTitle>Raporty — Linia Montażowa</PageTitle>

@if (!Auth.IsLoggedIn) { return; }

<!-- NAGŁÓWEK -->
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
    <div>
        <MudText Typo="Typo.h4" Style="font-weight:700;color:#1a2035;">Raporty dzienne</MudText>
        <MudText Typo="Typo.body2" Style="color:#888;">
            Zestawienie zleceń produkcyjnych i wskaźników OEE
        </MudText>
    </div>
    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
        <MudDatePicker @bind-Date="_dataOd" Label="Od" Variant="Variant.Outlined"
                       DateFormat="dd.MM.yyyy" Style="width:140px;" />
        <MudDatePicker @bind-Date="_dataDo" Label="Do" Variant="Variant.Outlined"
                       DateFormat="dd.MM.yyyy" Style="width:140px;" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Search"
                   OnClick="LoadRaport" Disabled="_loading">
            Szukaj
        </MudButton>
        <MudIconButton Icon="@Icons.Material.Filled.Print" Variant="Variant.Outlined"
                       Color="Color.Secondary" Title="Drukuj raport"
                       OnClick="@(() => { })" />
    </div>
</div>

@if (_loading)
{
    <div style="display:flex;justify-content:center;padding:60px;">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
    </div>
}
else
{
    <!-- KPI SUMMARY CARDS -->
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="6" sm="3">
            @SummaryCard("Zleceń łącznie",  _rows.Count.ToString(),                          "#5c6bc0", Icons.Material.Filled.Assignment)
        </MudItem>
        <MudItem xs="6" sm="3">
            @SummaryCard("Ukończonych",     _rows.Count(r => r.Status == "Zakonczone").ToString(), "#66bb6a", Icons.Material.Filled.CheckCircle)
        </MudItem>
        <MudItem xs="6" sm="3">
            @SummaryCard("Wyprodukowano OK", _rows.Sum(r => r.SztukOK).ToString() + " szt.",  "#26a69a", Icons.Material.Filled.Verified)
        </MudItem>
        <MudItem xs="6" sm="3">
            @SummaryCard("Wadliwych (NOK)", _rows.Sum(r => r.SztukNOK).ToString() + " szt.", "#ef5350", Icons.Material.Filled.Cancel)
        </MudItem>
    </MudGrid>

    <!-- OEE SUMMARY -->
    @if (_rows.Any(r => r.Zakonczone))
    {
        var doneRows = _rows.Where(r => r.Zakonczone).ToList();
        var avgOEE   = doneRows.Average(r => r.OEE);
        var avgQ     = doneRows.Average(r => r.Jakosc);
        var avgA     = doneRows.Where(r => r.Dostepnosc > 0).Select(r => r.Dostepnosc).DefaultIfEmpty(0).Average();
        var avgP     = doneRows.Where(r => r.Wydajnosc  > 0).Select(r => r.Wydajnosc ).DefaultIfEmpty(0).Average();

        <MudPaper Elevation="2" Style="padding:20px;border-radius:12px;margin-bottom:20px;border-left:4px solid #5c6bc0;">
            <MudText Typo="Typo.subtitle1" Style="font-weight:700;color:#1a2035;margin-bottom:12px;">
                📊 Średni OEE dla ukończonych zleceń (@doneRows.Count)
            </MudText>
            <MudGrid Spacing="2">
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.overline" Style="color:#999;">OEE (A×P×Q)</MudText>
                    <MudText Typo="Typo.h5" Style=@($"font-weight:700;color:{OeeColor(avgOEE)};")>
                        @avgOEE.ToString("P1")
                    </MudText>
                    <MudProgressLinear Value="@(avgOEE * 100)" Color="@OeeMudColor(avgOEE)" Rounded="true" Size="Size.Small" Class="mt-1" />
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.overline" Style="color:#999;">Dostępność (A)</MudText>
                    <MudText Typo="Typo.h5" Style=@($"font-weight:700;color:{OeeColor(avgA)};")>
                        @(avgA > 0 ? avgA.ToString("P1") : "—")
                    </MudText>
                    <MudProgressLinear Value="@(avgA * 100)" Color="Color.Info" Rounded="true" Size="Size.Small" Class="mt-1" />
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.overline" Style="color:#999;">Wydajność (P)</MudText>
                    <MudText Typo="Typo.h5" Style=@($"font-weight:700;color:{OeeColor(avgP)};")>
                        @(avgP > 0 ? avgP.ToString("P1") : "—")
                    </MudText>
                    <MudProgressLinear Value="@(avgP * 100)" Color="Color.Warning" Rounded="true" Size="Size.Small" Class="mt-1" />
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.overline" Style="color:#999;">Jakość (Q)</MudText>
                    <MudText Typo="Typo.h5" Style=@($"font-weight:700;color:{OeeColor(avgQ)};")>
                        @(avgQ > 0 ? avgQ.ToString("P1") : "—")
                    </MudText>
                    <MudProgressLinear Value="@(avgQ * 100)" Color="Color.Success" Rounded="true" Size="Size.Small" Class="mt-1" />
                </MudItem>
            </MudGrid>
        </MudPaper>
    }

    <!-- TABELA ZLECEŃ -->
    <MudPaper Elevation="2" Style="border-radius:12px;overflow:hidden;">
        <div style="padding:16px 20px 0;border-bottom:1px solid #eee;">
            <MudText Typo="Typo.subtitle1" Style="font-weight:700;color:#1a2035;margin-bottom:4px;">
                Zestawienie zleceń (@_rows.Count)
            </MudText>
        </div>

        @if (!_rows.Any())
        {
            <div style="padding:40px;text-align:center;color:#bbb;">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Style="font-size:48px;margin-bottom:12px;" />
                <MudText>Brak zleceń w wybranym zakresie dat.</MudText>
            </div>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table style="width:100%;border-collapse:collapse;font-size:13px;">
                    <thead>
                        <tr style="background:#f5f5f8;color:#666;font-weight:600;text-align:left;">
                            <th style="padding:12px 16px;">Zlecenie</th>
                            <th style="padding:12px 8px;">Wyrób</th>
                            <th style="padding:12px 8px;text-align:center;">Priorytet</th>
                            <th style="padding:12px 8px;text-align:center;">Status</th>
                            <th style="padding:12px 8px;text-align:center;">Plan</th>
                            <th style="padding:12px 8px;text-align:center;color:#66bb6a;">OK</th>
                            <th style="padding:12px 8px;text-align:center;color:#ef5350;">NOK</th>
                            <th style="padding:12px 8px;text-align:center;">Jakość</th>
                            <th style="padding:12px 8px;text-align:center;">OEE</th>
                            <th style="padding:12px 8px;">Rozpoczęto</th>
                            <th style="padding:12px 8px;">Ukończono</th>
                            <th style="padding:12px 8px;text-align:center;">Czas trwania</th>
                            <th style="padding:12px 8px;text-align:center;">Termin</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _rows)
                        {
                            <tr style=@($"border-top:1px solid #f0f0f0;{(r.Zakonczone ? "" : "background:#fafafa;")}"):>
                                <td style="padding:10px 16px;">
                                    <MudText Typo="Typo.body2" Style="font-weight:600;font-family:monospace;color:#1a2035;">
                                        @r.NazwaZlecenia
                                    </MudText>
                                    @if (r.CreatedAt.HasValue)
                                    {
                                        <MudText Typo="Typo.caption" Style="color:#aaa;display:block;">
                                            Utworzone: @r.CreatedAt.Value.ToString("dd.MM HH:mm")
                                        </MudText>
                                    }
                                </td>
                                <td style="padding:10px 8px;">
                                    <MudText Typo="Typo.body2">@(r.NazwaWyrobu ?? "—")</MudText>
                                </td>
                                <td style="padding:10px 8px;text-align:center;">
                                    <MudChip T="string" Size="Size.Small" Color="@PriorytetColor(r.Priorytet)"
                                             Style="height:22px;font-size:11px;">
                                        @r.Priorytet
                                    </MudChip>
                                </td>
                                <td style="padding:10px 8px;text-align:center;">
                                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(r.Status)"
                                             Style="height:22px;font-size:11px;">
                                        @r.Status
                                    </MudChip>
                                </td>
                                <td style="padding:10px 8px;text-align:center;font-weight:600;">@r.IloscSztuk</td>
                                <td style="padding:10px 8px;text-align:center;font-weight:700;color:#66bb6a;">
                                    @r.SztukOK
                                </td>
                                <td style="padding:10px 8px;text-align:center;font-weight:700;color:@(r.SztukNOK > 0 ? "#ef5350" : "#bbb");">
                                    @r.SztukNOK
                                </td>
                                <td style="padding:10px 8px;text-align:center;">
                                    @if (r.Jakosc > 0)
                                    {
                                        <div style="min-width:60px;">
                                            <MudText Typo="Typo.caption" Style=@($"font-weight:700;color:{OeeColor(r.Jakosc)};")>
                                                @r.Jakosc.ToString("P1")
                                            </MudText>
                                            <MudProgressLinear Value="@(r.Jakosc * 100)"
                                                               Color="@OeeMudColor(r.Jakosc)"
                                                               Rounded="true" Size="Size.Small" />
                                        </div>
                                    }
                                    else { <span style="color:#ccc;">—</span> }
                                </td>
                                <td style="padding:10px 8px;text-align:center;">
                                    @if (r.OEE > 0)
                                    {
                                        <div style="min-width:60px;">
                                            <MudText Typo="Typo.caption" Style=@($"font-weight:700;color:{OeeColor(r.OEE)};")>
                                                @r.OEE.ToString("P1")
                                            </MudText>
                                            <MudProgressLinear Value="@(r.OEE * 100)"
                                                               Color="@OeeMudColor(r.OEE)"
                                                               Rounded="true" Size="Size.Small" />
                                        </div>
                                    }
                                    else { <span style="color:#ccc;">—</span> }
                                </td>
                                <td style="padding:10px 8px;">
                                    <MudText Typo="Typo.caption">
                                        @(r.StartedAt.HasValue ? r.StartedAt.Value.ToString("dd.MM HH:mm") : "—")
                                    </MudText>
                                </td>
                                <td style="padding:10px 8px;">
                                    <MudText Typo="Typo.caption">
                                        @(r.CompletedAt.HasValue ? r.CompletedAt.Value.ToString("dd.MM HH:mm") : "—")
                                    </MudText>
                                </td>
                                <td style="padding:10px 8px;text-align:center;">
                                    @if (r.CzasTrwaniaMs > 0 && r.StartedAt.HasValue)
                                    {
                                        var ts = r.CzasTrwania;
                                        <MudText Typo="Typo.caption">
                                            @(ts.TotalHours >= 1
                                                ? $"{(int)ts.TotalHours}h {ts.Minutes:D2}m"
                                                : $"{ts.Minutes}m {ts.Seconds:D2}s")
                                        </MudText>
                                    }
                                    else { <span style="color:#ccc;">—</span> }
                                </td>
                                <td style="padding:10px 8px;text-align:center;">
                                    @if (r.DueTime.HasValue)
                                    {
                                        <MudIcon Icon="@(r.TerminOK ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Warning)"
                                                 Style=@($"color:{(r.TerminOK ? "#66bb6a" : "#ffa726")};font-size:18px;") />
                                    }
                                    else { <span style="color:#ccc;">—</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- STOPKA TABELI -->
            <div style="padding:12px 20px;background:#f9f9fb;border-top:1px solid #eee;display:flex;gap:20px;flex-wrap:wrap;">
                <MudText Typo="Typo.caption" Style="color:#666;">
                    <b>Łącznie OK:</b> @_rows.Sum(r => r.SztukOK) szt.
                </MudText>
                <MudText Typo="Typo.caption" Style="color:#666;">
                    <b>Łącznie NOK:</b> @_rows.Sum(r => r.SztukNOK) szt.
                </MudText>
                @if (_rows.Sum(r => r.SztukOK + r.SztukNOK) > 0)
                {
                    var totalQ = (double)_rows.Sum(r => r.SztukOK) / _rows.Sum(r => r.SztukOK + r.SztukNOK);
                    <MudText Typo="Typo.caption" Style=@($"color:{OeeColor(totalQ)};font-weight:700;")>
                        FTY: @totalQ.ToString("P1")
                    </MudText>
                }
                <MudText Typo="Typo.caption" Style="color:#666;">
                    <b>Termin dotrzymany:</b> @_rows.Count(r => r.Zakonczone && r.TerminOK) / @_rows.Count(r => r.Zakonczone)
                </MudText>
            </div>
        }
    </MudPaper>
}

@code {
    List<ZlecenieRaportRow> _rows    = new();
    bool _loading = true;
    DateTime? _dataOd = DateTime.Today;
    DateTime? _dataDo = DateTime.Today.AddDays(1);

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn || !Auth.CurrentUser!.IsSupervisor)
        { Nav.NavigateTo("/login"); return; }

        await LoadRaport();
    }

    async Task LoadRaport()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var od = _dataOd ?? DateTime.Today;
            var _do = (_dataDo ?? DateTime.Today).AddDays(1);
            _rows = await Orders.GetRaportAsync(od, _do);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Raporty] Błąd: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    RenderFragment SummaryCard(string title, string value, string color, string icon) => __builder =>
    {
        <MudPaper Elevation="2" Style=@($"padding:18px;border-radius:12px;border-left:4px solid {color};")>
            <div style="display:flex;justify-content:space-between;align-items:center;">
                <div>
                    <MudText Typo="Typo.overline" Style="color:#999;">@title</MudText>
                    <MudText Typo="Typo.h5" Style=@($"font-weight:700;color:{color};")>@value</MudText>
                </div>
                <MudIcon Icon="@icon" Style=@($"color:{color};font-size:32px;opacity:0.6;") />
            </div>
        </MudPaper>;
    };

    string OeeColor(double v) => v >= 0.85 ? "#66bb6a" : v >= 0.60 ? "#ffa726" : "#ef5350";
    Color  OeeMudColor(double v) => v >= 0.85 ? Color.Success : v >= 0.60 ? Color.Warning : Color.Error;

    Color StatusColor(string s) => s switch
    {
        "Zakonczone" => Color.Success,
        "W toku"     => Color.Info,
        "Wstrzymane" => Color.Warning,
        "Anulowane"  => Color.Error,
        _            => Color.Default
    };

    Color PriorytetColor(string p) => p switch
    {
        "Krytyczny"  => Color.Error,
        "Wysoki"     => Color.Warning,
        "Standardowy"=> Color.Primary,
        "Niski"      => Color.Default,
        _            => Color.Default
    };
}

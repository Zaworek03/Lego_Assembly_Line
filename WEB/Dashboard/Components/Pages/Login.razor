@page "/login"
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Logowanie — Linia Montażowa</PageTitle>

<MudThemeProvider />

<div style="min-height:100vh;background:linear-gradient(135deg,#1a2035 0%,#2d3561 50%,#1a2035 100%);
            display:flex;align-items:center;justify-content:center;">
    <MudPaper Elevation="12" Style="width:400px;padding:40px;border-radius:16px;background:rgba(255,255,255,0.97);">

        <div style="text-align:center;margin-bottom:32px;">
            <MudText Typo="Typo.h4" Style="font-weight:700;color:#1a2035;">🏭</MudText>
            <MudText Typo="Typo.h5" Style="font-weight:700;color:#1a2035;margin-top:8px;">Linia Montażowa</MudText>
            <MudText Typo="Typo.body2" Style="color:#666;margin-top:4px;">System monitorowania produkcji</MudText>
        </div>

        <EditForm Model="@this" OnValidSubmit="DoLogin">
            <MudTextField @bind-Value="_login"
                          Label="Login"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Person"
                          Class="mb-3" FullWidth="true" />

            <MudTextField @bind-Value="_haslo"
                          Label="Hasło"
                          Variant="Variant.Outlined"
                          InputType="@_pwdType"
                          Adornment="Adornment.End"
                          AdornmentIcon="@_pwdIcon"
                          OnAdornmentClick="TogglePwd"
                          Class="mb-4" FullWidth="true" />

            @if (_error)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">
                    Nieprawidłowy login lub hasło.
                </MudAlert>
            }

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       ButtonType="ButtonType.Submit"
                       FullWidth="true"
                       Size="Size.Large"
                       Disabled="_loading"
                       Style="border-radius:8px;font-weight:600;">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Zaloguj się
            </MudButton>
        </EditForm>

        <MudText Typo="Typo.caption" Align="Align.Center" Style="color:#999;margin-top:20px;display:block;">
            Supervisor: login=<b>supervisor</b> / haslo=<b>admin123</b>
        </MudText>
    </MudPaper>
</div>

@code {
    string _login  = "";
    string _haslo  = "";
    bool   _error  = false;
    bool   _loading = false;
    InputType _pwdType = InputType.Password;
    string _pwdIcon = Icons.Material.Filled.VisibilityOff;

    void TogglePwd()
    {
        _pwdType = _pwdType == InputType.Password ? InputType.Text : InputType.Password;
        _pwdIcon = _pwdType == InputType.Password
            ? Icons.Material.Filled.VisibilityOff
            : Icons.Material.Filled.Visibility;
    }

    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoLogin();
    }

    async Task DoLogin()
    {
        _loading = true;
        _error   = false;
        bool ok  = await Auth.LoginAsync(_login, _haslo);
        _loading = false;

        if (ok)
            Nav.NavigateTo(Auth.CurrentUser!.IsSupervisor ? "/" : "/moje-statystyki");
        else
            _error = true;
    }
}

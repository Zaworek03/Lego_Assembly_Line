@page "/login"
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Logowanie — Linia Montażowa</PageTitle>

<MudThemeProvider IsDarkMode="true" Theme="_loginTheme" />

<div style="min-height:100vh;background:radial-gradient(circle at 50% 0%,#25181A 0%,#131315 45%,#08080A 100%);
            display:flex;align-items:center;justify-content:center;">
    <MudPaper Elevation="12" Style="width:400px;padding:44px 40px;border-radius:20px;background:#121214;border:1px solid #1F1F23;">

        <div style="text-align:center;margin-bottom:32px;">
            <svg width="86" height="86" viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="rbGradLogin" x1="0" y1="0" x2="0.18" y2="1">
                        <stop offset="0%" stop-color="#7E2B3F" />
                        <stop offset="45%" stop-color="#B8434A" />
                        <stop offset="100%" stop-color="#F4704A" />
                    </linearGradient>
                </defs>
                <text x="60" y="88" font-family="Arial Black, Arial, Helvetica, sans-serif"
                      font-size="80" font-weight="900" font-style="italic" letter-spacing="-6"
                      text-anchor="middle" fill="url(#rbGradLogin)">RB</text>
            </svg>
            <MudText Typo="Typo.h5" Style="font-weight:800;color:#F2F2F3;margin-top:12px;">Linia Montażowa</MudText>
            <MudText Typo="Typo.body2" Style="color:#8B8B93;margin-top:4px;">System monitorowania produkcji</MudText>
        </div>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Login"
                   OnClick="DoLogin"
                   Style="border-radius:10px;font-weight:700;">
            Zaloguj się
        </MudButton>
    </MudPaper>
</div>

@code {
    // Strona logowania jest poza MainLayout, wiec ma wlasny motyw (ciemny + pomaranczowy akcent).
    readonly MudTheme _loginTheme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary       = "#FF6A3D",
            Secondary     = "#FF6A3D",
            Info          = "#FF6A3D",
            Error         = "#EF4444",
            Surface       = "#121214",
            Background    = "#08080A",
            TextPrimary   = "#F2F2F3",
            TextSecondary = "#8B8B93",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["Inter", "sans-serif"] }
        }
    };

    void DoLogin()
    {
        Auth.Login();
        Nav.NavigateTo("/");
    }
}
